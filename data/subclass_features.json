    "cleric": {
      "5": [
        {
          "name": "Destroy Undead",
          "desc": "When an undead of CR 1/2 or lower fails its save against your Turn Undead, it is destroyed instead of turned.",
          "kind": "passive"
        }
      ]
    },
    "rogue": {
      "1": [
        {
          "name": "Sneak Attack",
          "desc": "Once per turn, add {SNEAK}d6 damage to one attack that hits, if you have advantage on it or another enemy of the target is within 5 ft of it (and you do not have disadvantage). The attack must use a finesse or ranged weapon.",
          "kind": "passive"
        }
      ],
      "2": [
        {
          "name": "Cunning Action",
          "desc": "Bonus action: Dash, Disengage or Hide.",
          "kind": "passive",
          "activation": "bonus_action"
        }
      ],
      "5": [
        {
          "name": "Uncanny Dodge",
          "desc": "Reaction: when an attacker you can see hits you with an attack, halve the damage.",
          "kind": "passive",
          "activation": "reaction"
        }
      ]
    },
    "wizard": {
      "1": [
        {
          "name": "Arcane Recovery",
          "desc": "Once per day when you finish a short rest, recover expended spell slots with a combined level up to half your wizard level (rounded up). None of them can be 6th level or higher.",
