{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geezsuite.com/v1/schema.json",
  "description": "GeezSuite core schema for world entities and campaign state",
  "allOf": [
    {
      "$ref": "#/$defs/entity"
    }
  ],
  "$defs": {
    "campaign": {
      "type": "object",
      "required": [
        "info",
        "party",
        "reveals",
        "state"
      ],
      "properties": {
        "info": {
          "$ref": "#/$defs/campaign_info"
        },
        "party": {
          "type": "object"
        },
        "reveals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/reveal"
          }
        },
        "state": {
          "type": "object"
        }
      }
    },
    "log": {
      "type": "object",
      "required": [
        "id",
        "at",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "patch": {
          "type": "object",
          "additionalProperties": true
        },
        "status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "action": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "entity",
            "patch"
          ]
        },
        {
          "required": [
            "action",
            "args",
            "changes",
            "guards"
          ]
        }
      ]
    },
    "entity": {
      "type": "object",
      "description": "Standard wrapper for all world objects",
      "required": [
        "id",
        "kind",
        "name",
        "world",
        "meta"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(pc|npc|creature|item|place|map|faction|event|note)_[A-Za-z0-9_-]+$",
          "description": "Unique identifier with kind prefix"
        },
        "kind": {
          "enum": [
            "pc",
            "npc",
            "creature",
            "item",
            "place",
            "map",
            "faction",
            "event",
            "note"
          ],
          "description": "The type of entity"
        },
        "name": {
          "type": "string",
          "description": "Display name"
        },
        "world": {
          "const": "gaia",
          "description": "The shared world canon"
        },
        "campaign": {
          "type": [
            "string",
            "null"
          ],
          "description": "Campaign ID or null if shared canon"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "required": [
            "system"
          ],
          "additionalProperties": true,
          "properties": {
            "system": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "seed": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "description": "Roller seed (number or string)"
            }
          }
        },
        "meta": {
          "type": "object",
          "required": [
            "schema",
            "created_at",
            "updated_at"
          ],
          "properties": {
            "schema": {
              "const": 1
            },
            "created_at": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            },
            "updated_by": {
              "type": "string"
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pc"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_pc"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "npc"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_npc"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "creature"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_creature"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "item"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_item"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "place"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_place"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "map"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_map"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "faction"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_faction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "event"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_event"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "note"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_note"
              }
            }
          }
        }
      ]
    },
    "data_pc": {
      "type": "object",
      "additionalProperties": true,
      "description": "Player character data payload",
      "properties": {
        "player_name": {
          "type": "string"
        },
        "combat": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "data_npc": {
      "type": "object",
      "additionalProperties": true,
      "description": "Non-player character data payload",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/npc_profile"
        },
        "statblock": {
          "$ref": "#/$defs/statblock"
        },
        "portrait": {
          "type": "string"
        },
        "token": {
          "type": "object",
          "properties": {
            "avatar": {
              "type": "string"
            },
            "size": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string"
        },
        "disposition": {
          "enum": [
            "friendly",
            "neutral",
            "hostile"
          ]
        },
        "home": {
          "type": "string",
          "description": "Place ID"
        }
      }
    },
    "data_creature": {
      "type": "object",
      "additionalProperties": true,
      "description": "Creature/monster data payload",
      "required": [
        "statblock"
      ],
      "properties": {
        "statblock": {
          "$ref": "#/$defs/statblock"
        }
      }
    },
    "data_item": {
      "type": "object",
      "additionalProperties": true,
      "description": "Equipment or loot data payload",
      "properties": {
        "srd_index": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "rarity": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "magic": {
          "type": "boolean"
        }
      }
    },
    "data_place": {
      "type": "object",
      "additionalProperties": true,
      "description": "Location or geography data payload",
      "properties": {
        "place_kind": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "description": "Parent place ID"
        },
        "position": {
          "type": "object",
          "properties": {
            "map": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "world_pos": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "description": {
          "type": "string"
        },
        "lore": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "data_map": {
      "type": "object",
      "additionalProperties": true,
      "description": "Tactical or regional map data payload",
      "properties": {
        "image": {
          "type": "string"
        },
        "grid_size": {
          "type": "number"
        },
        "parent_map": {
          "type": "string"
        },
        "parent_place": {
          "type": "string"
        },
        "dd2vtt": {
          "type": "string",
          "description": "Path/URL of the .dd2vtt file: the universal layer (image, grid, walls, doors, lights) every renderer reads"
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        },
        "roads": {
          "type": "object",
          "additionalProperties": true
        },
        "scene": {
          "$ref": "#/$defs/geez2vtt"
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Per floor: {level, name, dd2vtt?, image?}"
        },
        "size": {
          "type": "object",
          "additionalProperties": true,
          "description": "{cols, rows} in grid cells"
        }
      }
    },
    "data_faction": {
      "type": "object",
      "additionalProperties": true,
      "description": "Group or organization data payload",
      "properties": {
        "description": {
          "type": "string"
        },
        "goals": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        }
      }
    },
    "data_event": {
      "type": "object",
      "additionalProperties": true,
      "description": "Temporal or historical event data payload",
      "properties": {
        "when": {
          "type": "string"
        },
        "where": {
          "type": "string",
          "description": "Place ID"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "data_note": {
      "type": "object",
      "additionalProperties": true,
      "description": "Free-text note data payload",
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "npc_profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "first_name": {
          "type": "string"
        },
        "surname": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "ancestry": {
          "type": "string"
        },
        "second_ancestry": {
          "type": "string"
        },
        "age": {
          "type": "string",
          "description": "Age as rolled, a word or number (e.g. young, middle-aged, 40)"
        },
        "height": {
          "type": "string"
        },
        "profession": {
          "type": "string"
        },
        "hero_class": {
          "type": "string"
        },
        "demeanor": {
          "type": "string"
        },
        "trait": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        },
        "backstory": {
          "type": "string"
        },
        "appearance": {
          "type": "object",
          "properties": {
            "hair": {
              "type": "string"
            },
            "skin": {
              "type": "string"
            },
            "facial_features": {
              "type": "string"
            },
            "facial_hair": {
              "type": "string"
            },
            "distinctive_feature": {
              "type": "string"
            },
            "clothing": {
              "type": "string"
            }
          }
        },
        "gear": {
          "type": "object",
          "properties": {
            "armor": {
              "type": "string"
            },
            "weapon": {
              "type": "string"
            }
          }
        }
      }
    },
    "statblock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "srd_index": {
          "type": "string"
        },
        "cr": {
          "type": "string"
        },
        "xp": {
          "type": "number"
        },
        "size": {
          "type": "string"
        },
        "creature_type": {
          "type": "string"
        },
        "alignment": {
          "type": "string"
        },
        "stats": {
          "type": "object",
          "properties": {
            "str": {
              "type": "number"
            },
            "dex": {
              "type": "number"
            },
            "con": {
              "type": "number"
            },
            "int": {
              "type": "number"
            },
            "wis": {
              "type": "number"
            },
            "cha": {
              "type": "number"
            }
          }
        },
        "combat": {
          "type": "object",
          "properties": {
            "ac": {
              "type": "number"
            },
            "hp_current": {
              "type": "number"
            },
            "hp_max": {
              "type": "number"
            },
            "temp_hp": {
              "type": "number"
            },
            "speed": {
              "type": "string"
            },
            "initiative_bonus": {
              "type": "number"
            },
            "proficiency_bonus": {
              "type": "number"
            }
          }
        },
        "attacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "features_traits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "Origin entity ID"
        },
        "to": {
          "type": "string",
          "description": "Target entity ID"
        },
        "role": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "campaign": {
          "type": "string"
        }
      }
    },
    "reveal": {
      "type": "object",
      "required": [
        "known"
      ],
      "properties": {
        "known": {
          "type": "boolean"
        },
        "revealed_at": {
          "type": "string"
        },
        "board": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      }
    },
    "token": {
      "type": "object",
      "required": [
        "entity",
        "map",
        "x",
        "y"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "description": "Entity ID (pc, npc, or creature)"
        },
        "map": {
          "type": "string",
          "description": "Map entity ID"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "size": {
          "type": "string"
        },
        "hp_current": {
          "type": "number"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "log_entry": {
      "type": "object",
      "required": [
        "at",
        "type",
        "text"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "campaign_info": {
      "type": "object",
      "required": [
        "name",
        "world",
        "gm"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "world": {
          "const": "gaia"
        },
        "gm": {
          "type": "string",
          "description": "GM user ID"
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "weather": {
          "enum": [
            "clear",
            "cloudy",
            "rain",
            "storm",
            "fog",
            "snow",
            "ash"
          ]
        },
        "wind": {
          "type": "string"
        },
        "time_of_day": {
          "enum": [
            "dawn",
            "day",
            "dusk",
            "night"
          ]
        },
        "day_number": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "party_location": {
      "type": "string"
    },
    "initiative": {
      "type": "object",
      "required": [
        "round",
        "turn",
        "order"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "init"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "entity": {
                "type": "string"
              },
              "init": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "line",
          "writes"
        ],
        "properties": {
          "line": {
            "type": "string"
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "before",
                "value"
              ]
            }
          }
        }
      }
    },
    "geez2vtt": {
      "type": "object",
      "properties": {
        "format": {
          "const": "geez2vtt"
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "grid": {
          "type": "object",
          "properties": {
            "cols": {
              "type": "integer",
              "minimum": 1
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "cell_ft": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "cols",
            "rows",
            "cell_ft"
          ],
          "additionalProperties": true
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "elevation": {
                "type": "number"
              },
              "source": {
                "type": "string"
              },
              "cells": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^-?\\d+,-?\\d+$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "floor": {
                      "type": "string"
                    },
                    "terrain": {
                      "type": "string"
                    },
                    "elevation": {
                      "type": "number"
                    }
                  },
                  "required": [],
                  "additionalProperties": true
                }
              },
              "walls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "a": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "b": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "material": {
                      "type": "string"
                    },
                    "object": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "a",
                    "b",
                    "material"
                  ],
                  "additionalProperties": true
                }
              },
              "portals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "a": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "b": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "material": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "door",
                        "window",
                        "arch"
                      ]
                    },
                    "closed": {
                      "type": "boolean"
                    },
