{
  "rules": {
    ".read": true,

    "$other": {
      ".write": true
    },

    "geezvtt": {
      "meta": {
        "dmUid": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
        }
      },
      "campaign": {
        ".write": "auth != null && auth.uid === root.child('geezvtt/meta/dmUid').val()"
      },
      "party": {
        ".write": true
      },
      "live": {
        ".write": true
      }
    }
  }
}
